[gundulabs]
name=Gundu Labs
baseurl=https://download.copr.fedorainfracloud.org/results/gundulabs/gaze/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
enabled=1
gpgcheck=1
