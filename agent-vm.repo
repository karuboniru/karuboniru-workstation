[agent-vm]
name=Copr repo for agent-vm owned by yanqiyu
baseurl=https://download.copr.fedorainfracloud.org/results/yanqiyu/agent-vm/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
